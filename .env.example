# LAAD - ATM Log Aggregation, Analysis & Diagnostics Platform

# Copy this file to .env and update the values before running:
#   cp .env.example .env

# GENERATOR CONFIGURATION
# Tick interval (seconds) between emission cycles
TICK_SECONDS=1

# Historical backfill minutes on startup (0 = disabled)
BACKFILL_MINUTES=0

# Anomaly injection probability (0.001 = 0.1%) — realistic for ATM fleet ops
ANOMALY_PROB=0.001

# Optional: Seed for reproducible generation
GENERATOR_SEED=


# DATABASE CONFIGURATION
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=atm_platform
POSTGRES_USER=atm_user
POSTGRES_PASSWORD= # REQUIRED: Set your password before running

# JWT AUTHENTICATION
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY= # REQUIRED: Generate a secure secret key


# TEST DATABASE (used by pytest)
TEST_POSTGRES_HOST=postgres_test
TEST_POSTGRES_PORT=5432
TEST_POSTGRES_DB=atm_platform_test
TEST_POSTGRES_USER=atm_user
TEST_POSTGRES_PASSWORD= # REQUIRED: Same as POSTGRES_PASSWORD


# ML ANOMALY DETECTION
MLFLOW_TRACKING_URI=http://localhost:5001


# RAG DIAGNOSTIC ASSISTANT - LLM PROVIDERS
# Primary: W&B Serverless Inference (OpenAI-compatible chat completions, foundation models directly)
# Get API key from https://wandb.ai/settings (W&B account with Inference credits required)
WANDB_API_KEY= # REQUIRED: Your W&B API key (used for ALL inference below)

# Primary LLM for the agentic RAG retrofit (W&B Serverless Inference by default)
# Used for the agent, generator, self-consistency, reflexion AND the RAGAS judge.
# Same model across all three eval systems so RAGAS deltas are retrieval-only.
# Pick a model via: curl -s $LLM_BASE_URL/models -H "Authorization: Bearer $WANDB_API_KEY"
# (e.g. a current mid-size Qwen/Llama instruct model)
LLM_BASE_URL=https://api.inference.wandb.ai/v1
LLM_API_KEY= # leave empty to default to WANDB_API_KEY above (config reads WANDB_API_KEY or LLM_API_KEY)
LLM_MODEL= # REQUIRED: model ID from the List Models endpoint, e.g. a current mid-size Qwen/Llama instruct

# OpenRouter / Ollama Cloud are no longer functional as LLM providers (removed, not fallback).
# The local ollama container (nomic-embed-text) remains for Chroma embeddings only.


# RAG CONFIGURATION
# Query Classification: Stats queries bypass LLM, query DB directly for faster responses
# Stats: how many, count of, total -> direct PostgreSQL
# Diagnostic: what's wrong, why is, root cause -> ChromaDB + LLM
# Troubleshooting: how to fix, what to do -> ChromaDB + LLM with numbered steps
# General: everything else -> ChromaDB + LLM with summary

# Retrieval settings
RAG_TOP_K=3
RAG_SAMPLES=1
RAG_TEMPERATURE=0.6
RAG_CHUNK_TRUNCATE=800

# Confidence thresholds
CONF_HIGH=0.8
CONF_MEDIUM=0.5

# REDIS CACHE (for RAG response caching)
# Host: 'redis' for Docker, 'localhost' for local development
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_TTL=300


# MLFLOW PRODUCTION CONFIG (S3 + RDS)
#
# The default dev config uses local SQLite + Docker volume:
#   MLFLOW_BACKEND_STORE_URI=sqlite:////mlflow/artifacts/mlflow.db
#   MLFLOW_S3_ARTIFACT_ROOT=/mlflow/artifacts
#
# For production, use AWS RDS PostgreSQL + S3:
MLFLOW_BACKEND_STORE_URI=postgresql://db_user:db_password@your-rds-endpoint.rds.amazonaws.com:5432/mlflow_db
MLFLOW_S3_ARTIFACT_ROOT=s3://your-bucket-name/mlflow-artifacts
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_DEFAULT_REGION=eu-west-2

# Git SHA for MLflow runs.
# Run in terminal BEFORE docker-compose up:
#   export GIT_COMMIT_SHA=$(git rev-parse HEAD | cut -c1-8)
GIT_COMMIT_SHA=
