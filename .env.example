# Generator Configuration
TICK_SECONDS=1
ANOMALY_PROB=0.02
GIT_PYTHON_REFRESH=quiet
GENERATOR_SEED=

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=atm_platform
POSTGRES_USER=atm_user
POSTGRES_PASSWORD= # set before running docker compose up

# JWT Configuration (change in production)
JWT_SECRET_KEY= # set before running docker compose up

# ML Anomaly Detection Configuration
# Enable/disable individual detection layers
ML_HEURISTICS_ENABLED=true
ML_RULES_DETECTION_ENABLED=true
MLFLOW_TRACKING_URI=http://localhost:5001

# Test Database Configuration (used by pytest service)
TEST_POSTGRES_HOST=postgres_test
TEST_POSTGRES_PORT=5432
TEST_POSTGRES_DB=atm_platform_test
TEST_POSTGRES_USER=atm_user
TEST_POSTGRES_PASSWORD= # same as POSTGRES_PASSWORD

# RAG Diagnostic Assistant Configuration - Google Gemini & OpenRouter
# Required: Get your API key from https://aistudio.google.com/app
GEMINI_API_KEY= # set your Google AI Studio API key here

# Fallback LLM providers
OPENROUTER_API_KEY= # get from https://openrouter.ai

# RAG Configuration
RAG_PRIMARY_MODEL=gemini-3.1-flash
RAG_FALLBACK_MODEL=groq/llama-3.1-70b-versatile
RAG_TOP_K=5
RAG_SAMPLES=3
RAG_TEMPERATURE=0.6
CONF_HIGH=0.8
CONF_MEDIUM=0.5
RAG_CALIBRATION_ENABLED=true
